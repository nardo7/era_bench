digraph ArcEmbodiedHighLevelActions {
  graph [
    label="ARC Embodied — Stored High-Level Actions",
    labelloc=t,
    fontsize=21,
    fontname="Arial",
    rankdir=LR,
    bgcolor="white",
    pad=0.25,
    nodesep=0.35,
    ranksep=0.55,
    splines=polyline
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Arial",
    fontsize=11,
    color="#334155",
    penwidth=1.2,
    margin="0.18,0.12"
  ];

  edge [
    color="#64748B",
    arrowsize=0.7,
    penwidth=1.1
  ];

  hdf5 [
    label="HDF5 dataset",
    shape=cylinder,
    style=filled,
    fillcolor="#D1FAE5",
    color="#059669"
  ];

  group [
    label="/data/demo_<n>/\nhigh_level_actions/",
    fillcolor="#DBEAFE",
    color="#60A5FA"
  ];

  timeline [
    label="action_timeline\nint64  [1, T, 4]",
    fillcolor="#BFDBFE",
    color="#3B82F6",
    penwidth=1.4
  ];

  fields [
    label="[ phase, color_id, goal_row, goal_col ]",
    fillcolor="#EDE9FE",
    color="#8B5CF6"
  ];

  legend [
    label="phase\n0  no action\n1  grasp\n2  place\n\ncolor_id\nARC color ID\n\ngoal_row, goal_col\nzero-based ARC output-grid cell\n\nno action: -1 for color and goal",
    fillcolor="#F5F3FF",
    color="#A78BFA"
  ];

  hdf5 -> group -> timeline -> fields -> legend;
}
